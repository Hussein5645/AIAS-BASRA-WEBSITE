{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ],
  "hosting": {
    "site": "space-42d87",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "downloads/AIAS-Basra-Community-1.9-release.apk",
      "downloads/AIAS-Basra-Community-2.0-release.apk",
      "downloads/AIAS-Basra-Community-2.1-release.apk",
        "downloads/AIAS-Basra-Community-2.2-release.apk",
        "downloads/AIAS-Basra-Community-2.3-release.apk",
        "downloads/AIAS-Basra-Community-2.4-release.apk",
        "downloads/AIAS-Basra-Community-2.5-release.apk",
        "downloads/AIAS-Basra-Community-2.6-release.apk",
        "downloads/AIAS-Basra-Community-2.7-release.apk",
        "downloads/AIAS-Basra-Community-2.8-release.apk"
    ],
    "rewrites": [
      {
        "source": "/share/**",
        "function": {
          "functionId": "communityShare"
        }
      },
      {
        "source": "/a/**",
        "destination": "/index.html"
      },
      {
        "source": "/p/**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/js/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/css/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/downloads/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment"
          }
        ]
      },
      {
        "source": "/auth-relay.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/community-notifications-sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "Service-Worker-Allowed",
            "value": "/"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8085
    },
    "functions": {
      "port": 5001
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9199
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true
    }
  }
}
