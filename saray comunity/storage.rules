rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isImage() { return request.resource.contentType.matches('image/(jpeg|png|webp)'); }
    function isChatMedia() { return request.resource.contentType.matches('(image/(jpeg|png|webp)|audio/(webm|mp4|ogg|aac|mpeg))'); }
    function canReadSpaceChat(spaceId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/communitySpaces/$(spaceId)/access/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/communitySpaces/$(spaceId)/access/$(request.auth.uid)).data.get('canUseChat', false) == true
        && firestore.get(/databases/(default)/documents/communitySpaces/$(spaceId)/access/$(request.auth.uid)).data.get('blocked', false) != true
        && firestore.get(/databases/(default)/documents/communitySpaces/$(spaceId)/access/$(request.auth.uid)).data.get('chatBanned', false) != true;
    }
    function canUploadSpaceChat(spaceId, userId) {
      return canReadSpaceChat(spaceId) && request.auth.uid == userId;
    }
    function canReadPostMedia(postId) {
      let post = firestore.get(/databases/(default)/documents/communityPosts/$(postId)).data;
      let slug = post.get('communitySlug', 'main');
      return post.get('published', false) == true
        && post.get('archived', false) != true
        && post.get('moderationStatus', 'clear') != 'flagged'
        && (slug == 'main'
          || !signedIn()
          || !firestore.exists(/databases/(default)/documents/communitySpaces/$(slug)/access/$(request.auth.uid))
          || firestore.get(/databases/(default)/documents/communitySpaces/$(slug)/access/$(request.auth.uid)).data.get('blocked', false) != true)
        && (post.get('visibility', 'public') == 'public'
          || (signedIn()
            && firestore.exists(/databases/(default)/documents/communitySpaces/$(slug)/access/$(request.auth.uid))
            && firestore.get(/databases/(default)/documents/communitySpaces/$(slug)/access/$(request.auth.uid)).data.get('canReadPosts', false) == true));
    }
    function canUploadPostMedia(postId) {
      let post = firestore.get(/databases/(default)/documents/communityPosts/$(postId)).data;
      let slug = post.get('communitySlug', 'main');
      return signedIn()
        && post.userId == request.auth.uid
        && post.get('published', false) == false
        && ((slug == 'main'
            && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('mainThreadPostingAccess', true) == true)
          || (slug != 'main'
            && firestore.exists(/databases/(default)/documents/communitySpaces/$(slug)/access/$(request.auth.uid))
            && firestore.get(/databases/(default)/documents/communitySpaces/$(slug)/access/$(request.auth.uid)).data.get('member', false) == true
            && firestore.get(/databases/(default)/documents/communitySpaces/$(slug)/access/$(request.auth.uid)).data.get('blocked', false) != true
            && firestore.get(/databases/(default)/documents/communitySpaces/$(slug)/access/$(request.auth.uid)).data.get('canReadPosts', false) == true));
    }
    match /community/posts/{postId}/{fileName} {
      allow read: if canReadPostMedia(postId);
      allow create, update: if canUploadPostMedia(postId)
        && request.resource.size <= 10 * 1024 * 1024
        && isImage();
      allow delete: if false;
    }

    match /community/profiles/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.size <= 10 * 1024 * 1024 && isImage();
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /community/spaces/{spaceId}/{fileName} {
      allow read: if true;
      allow create, update: if signedIn()
        && firestore.get(/databases/(default)/documents/communitySpaces/$(spaceId)).data.creatorId == request.auth.uid
        && request.resource.size <= 10 * 1024 * 1024 && isImage();
      allow delete: if signedIn()
        && firestore.get(/databases/(default)/documents/communitySpaces/$(spaceId)).data.creatorId == request.auth.uid;
    }

    match /community/space-messages/{spaceId}/{userId}/{fileName} {
      allow read: if canReadSpaceChat(spaceId);
      allow create: if canUploadSpaceChat(spaceId, userId)
        && request.resource.size <= 12 * 1024 * 1024
        && isChatMedia();
      // Chat history is permanent, including its attached images.
      allow update, delete: if false;
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
