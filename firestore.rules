rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/config/admins).data.admins.hasAny([request.auth.token.email.lower()]);
    }
    
    // User profiles - users can read/write their own data
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Config documents - admins only can write, all can read
    match /config/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Content documents - admins can write, all can read
    match /content/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Community interactions for articles: one vote per signed-in user and
    // comments owned by the user who created them.
    match /content/magazine/articles/{articleId}/votes/{userId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() && request.auth.uid == userId;
    }

    match /content/magazine/articles/{articleId}/comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
