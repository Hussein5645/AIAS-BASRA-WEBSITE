rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/config/admins).data.admins.hasAny([request.auth.token.email.lower()]);
    }
    
    // Community profiles are public; only the owner can create or update one.
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
    }

    // Community posts are authored by authenticated users with a completed
    // profile. Admins may approve, feature, and moderate every post.
    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if isAdmin() || (isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileComplete == true
        && request.resource.data.type in ['article', 'behance']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.summary is string
        && request.resource.data.summary.size() > 0
        && request.resource.data.summary.size() <= 360);
      allow update: if isAdmin() || (isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.featured == resource.data.featured
        && request.resource.data.featureStatus == resource.data.featureStatus);
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /communityPosts/{postId}/votes/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.value in [-1, 0, 1];
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    match /communityPosts/{postId}/comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }
    
    // Config documents - admins only can write, all can read
    match /config/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Content documents - admins can write, all can read
    match /content/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Community interactions for articles: one vote per signed-in user and
    // comments owned by the user who created them.
    match /content/magazine/articles/{articleId}/votes/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.value in [-1, 0, 1];
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    match /content/magazine/articles/{articleId}/comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && (request.resource.data.parentId == null || request.resource.data.parentId is string);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
