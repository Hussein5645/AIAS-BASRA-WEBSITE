rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isImage() { return request.resource.contentType.matches('image/(jpeg|png|webp)'); }

    match /community/posts/{postId}/{fileName} {
      // Post images are public community content. Archived-post visibility remains
      // controlled by Firestore and their display paths, while download URLs are
      // tokenized by Firebase Storage.
      allow read: if true;
      allow create, update: if signedIn()
        && firestore.get(/databases/(default)/documents/communityPosts/$(postId)).data.userId == request.auth.uid
        && firestore.get(/databases/(default)/documents/communityPosts/$(postId)).data.published == false
        && request.resource.size <= 10 * 1024 * 1024
        && isImage();
      allow delete: if false;
    }

    match /community/profiles/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.size <= 10 * 1024 * 1024 && isImage();
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /community/spaces/{spaceId}/{fileName} {
      allow read: if true;
      allow create, update: if signedIn()
        && firestore.get(/databases/(default)/documents/communitySpaces/$(spaceId)).data.creatorId == request.auth.uid
        && request.resource.size <= 10 * 1024 * 1024 && isImage();
      allow delete: if signedIn()
        && firestore.get(/databases/(default)/documents/communitySpaces/$(spaceId)).data.creatorId == request.auth.uid;
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
