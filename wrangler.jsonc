{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aias-basra",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "account_id": "896722b97bdd64d08fe1100378af1e3c",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "aias-basra-media"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aias-basra",
      "database_id": "465dda01-b114-46e0-ba36-f0b35ae01b99",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "658382934950-ki0n8ahuoaos98neqnqn5oltshgeim5i.apps.googleusercontent.com",
    "ADMIN_EMAILS": "basrah@aias.org,mklkoklpp@gmail.com",
    "VAPID_PUBLIC_KEY": "BCg7mD_lJJiVzaQAbyxkRwHt1rEOInEgU0iZdSq9buQlDIhUN9eJQAHBSO-PZCKY6H-7DNDg4213e5Va4-TTiLM"
  },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "aiasbsr.com",
      "custom_domain": true
    },
    {
      "pattern": "www.aiasbsr.com",
      "custom_domain": true
    }
  ]
}
