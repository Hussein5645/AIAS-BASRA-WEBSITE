rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function signedInEmail() {
      return request.auth.token.email.lower();
    }

    // Emails in config/admins remain protected super admins so the existing
    // installation can migrate to roles without locking anyone out.
    function isLegacySuperAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/config/admins)
        && get(/databases/$(database)/documents/config/admins).data.admins is list
        && get(/databases/$(database)/documents/config/admins).data.admins.hasAny([signedInEmail()]);
    }

    function hasRoleAssignment() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/config/userRoles)
        && exists(/databases/$(database)/documents/config/roles)
        && get(/databases/$(database)/documents/config/userRoles).data.assignments is map
        && signedInEmail() in get(/databases/$(database)/documents/config/userRoles).data.assignments
        && get(/databases/$(database)/documents/config/roles).data.roles is map
        && get(/databases/$(database)/documents/config/userRoles).data.assignments[signedInEmail()] in get(/databases/$(database)/documents/config/roles).data.roles;
    }

    function assignedRoleId() {
      return get(/databases/$(database)/documents/config/userRoles).data.assignments[signedInEmail()];
    }

    function assignedPermissions() {
      return get(/databases/$(database)/documents/config/roles).data.roles[assignedRoleId()].permissions;
    }

    function isSuperAdmin() {
      return isLegacySuperAdmin()
        || (hasRoleAssignment()
          && assignedPermissions() is list
          && (assignedRoleId() == 'super_admin' || assignedPermissions().hasAny(['*'])));
    }

    function isAdmin() {
      return isSuperAdmin() || hasRoleAssignment();
    }

    function hasPermission(permission) {
      return isSuperAdmin()
        || (hasRoleAssignment()
          && assignedPermissions() is list
          && assignedPermissions().hasAny([permission]));
    }

    function canReadLivePost(post) {
      let slug = post.get('communitySlug', 'main');
      return post.get('published', false) == true
        && post.get('archived', false) != true
        && post.get('moderationStatus', 'clear') != 'flagged'
        && (slug == 'main'
          || !isAuthenticated()
          || !exists(/databases/$(database)/documents/communitySpaces/$(slug)/access/$(request.auth.uid))
          || get(/databases/$(database)/documents/communitySpaces/$(slug)/access/$(request.auth.uid)).data.get('blocked', false) != true)
        && (post.get('visibility', 'public') == 'public'
          || (isAuthenticated()
            && exists(/databases/$(database)/documents/communitySpaces/$(slug)/access/$(request.auth.uid))
            && get(/databases/$(database)/documents/communitySpaces/$(slug)/access/$(request.auth.uid)).data.get('canReadPosts', false) == true));
    }

    function canListLivePost(post) {
      return canReadLivePost(post);
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || hasPermission('view_community') || hasPermission('manage_community'));
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.get('profileComplete', false) == false
        && request.resource.data.get('mainThreadPostingAccess', false) == false
        && request.resource.data.get('mainThreadAccessStatus', 'not_requested') == 'not_requested'
        && (!('verified' in request.resource.data) || request.resource.data.verified == false)
        && !('verifiedAt' in request.resource.data)
        && !('verifiedBy' in request.resource.data)
        && (!('username' in request.resource.data)
          || getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.userId == userId)
        && (!('photoBase64' in request.resource.data) || request.resource.data.photoBase64 == '')
        && (!('bannerBase64' in request.resource.data) || request.resource.data.bannerBase64 == '')
        && (!('photoURL' in request.resource.data) || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2000))
        && (!('bannerURL' in request.resource.data) || (request.resource.data.bannerURL is string && request.resource.data.bannerURL.size() <= 2000));
      allow update: if (hasPermission('manage_community')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified', 'verifiedAt', 'verifiedBy'])
          && request.resource.data.verified is bool
          && request.resource.data.verifiedAt == request.time
          && request.resource.data.verifiedBy == signedInEmail())
        || (isAuthenticated()
          && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified', 'verifiedAt', 'verifiedBy', 'profileComplete', 'mainThreadPostingAccess', 'mainThreadAccessStatus', 'mainThreadAccessRequestedAt', 'mainThreadAccessReviewedAt', 'mainThreadAccessReviewedBy'])
          && (!('username' in request.resource.data)
            || getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.userId == userId)
          && (!('photoBase64' in request.resource.data) || request.resource.data.photoBase64 == '')
          && (!('bannerBase64' in request.resource.data) || request.resource.data.bannerBase64 == '')
          && (!('photoURL' in request.resource.data) || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2000))
          && (!('bannerURL' in request.resource.data) || (request.resource.data.bannerURL is string && request.resource.data.bannerURL.size() <= 2000)));
    }


    match /publicProfiles/{userId} {
      allow read: if true;
      allow write: if false;
    }

    function isSpaceOwner(spaceId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/communitySpaces/$(spaceId)).data.creatorId == request.auth.uid;
    }

    function isSpaceManager(spaceId) {
      return isSpaceOwner(spaceId)
        || (isAuthenticated()
          && exists(/databases/$(database)/documents/communitySpaces/$(spaceId)/admins/$(request.auth.uid)));
    }

    function isSpaceChatMember(spaceId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/communitySpaces/$(spaceId)/access/$(request.auth.uid))
        && get(/databases/$(database)/documents/communitySpaces/$(spaceId)/access/$(request.auth.uid)).data.get('canUseChat', false) == true
        && get(/databases/$(database)/documents/communitySpaces/$(spaceId)/access/$(request.auth.uid)).data.get('blocked', false) != true
        && get(/databases/$(database)/documents/communitySpaces/$(spaceId)/access/$(request.auth.uid)).data.get('chatBanned', false) != true;
    }

    function validRepostLink(sourcePostId) {
      let repostId = request.resource.data.repostedPostId;
      return getAfter(/databases/$(database)/documents/communityPosts/$(repostId)).data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/communityPosts/$(repostId)).data.repostedFromPostId == sourcePostId
        && getAfter(/databases/$(database)/documents/communityPosts/$(repostId)).data.communitySlug == 'main';
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if (hasPermission('manage_community')
          && request.resource.data.recipientId == userId
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.actorName == 'AIAS Basra moderation'
          && request.resource.data.type in ['moderation_flagged', 'moderation_cleared', 'moderation_warned', 'moderation_archived', 'moderation_restored', 'moderation_permanently_deleted']
          && request.resource.data.reason is string
          && request.resource.data.reason.size() <= 500
          && request.resource.data.createdAt == request.time
          && request.resource.data.read == false)
        || (isAuthenticated()
        && request.resource.data.recipientId == userId
        && request.resource.data.actorId == request.auth.uid
        && userId != request.auth.uid
        && request.resource.data.type in ['comment', 'reply', 'applause', 'connection', 'space_connection', 'space_request', 'space_post', 'mention', 'space_mention']
        && request.resource.data.postId is string
        && request.resource.data.detailId is string
        && request.resource.data.actorName is string
        && request.resource.data.actorName.size() <= 100
        && request.resource.data.actorUsername is string
        && request.resource.data.actorUsername.size() <= 24
        && request.resource.data.postTitle is string
        && request.resource.data.postTitle.size() <= 160
        && request.resource.data.createdAt == request.time
        && request.resource.data.read == false
        && (((request.resource.data.type in ['comment', 'reply', 'applause'])
            && exists(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId))
            && ((request.resource.data.type == 'applause'
                && get(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)).data.userId == userId
                && exists(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)/votes/$(request.auth.uid))
                && get(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)/votes/$(request.auth.uid)).data.value == 1)
              || (request.resource.data.type == 'comment'
                && get(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)).data.userId == userId
                && exists(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)/comments/$(request.resource.data.detailId))
                && get(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)/comments/$(request.resource.data.detailId)).data.userId == request.auth.uid)
              || (request.resource.data.type == 'reply'
                && exists(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)/comments/$(request.resource.data.detailId))
                && get(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)/comments/$(request.resource.data.detailId)).data.userId == userId)))
          || (request.resource.data.type == 'space_post'
            && exists(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId))
            && get(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)).data.userId == request.auth.uid
            && get(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)).data.communitySlug == request.resource.data.detailId
            && exists(/databases/$(database)/documents/communitySpaces/$(request.resource.data.detailId))
            && get(/databases/$(database)/documents/communitySpaces/$(request.resource.data.detailId)).data.creatorId == userId)
          || (request.resource.data.type == 'mention'
            && request.resource.data.sourceId is string
            && request.resource.data.sourceId.size() <= 128
            && exists(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId))
            && ((request.resource.data.sourceId == ''
                && get(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)).data.userId == request.auth.uid)
              || (request.resource.data.sourceId != ''
                && exists(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)/comments/$(request.resource.data.sourceId))
                && get(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)/comments/$(request.resource.data.sourceId)).data.userId == request.auth.uid)))
          || (request.resource.data.type == 'space_mention'
            && request.resource.data.sourceId is string
            && request.resource.data.sourceId.size() <= 128
            && exists(/databases/$(database)/documents/communitySpaces/$(request.resource.data.detailId))
            && get(/databases/$(database)/documents/communitySpaces/$(request.resource.data.detailId)).data.creatorId == userId
            && exists(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId))
            && ((request.resource.data.sourceId == ''
                && get(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)).data.userId == request.auth.uid)
              || (request.resource.data.sourceId != ''
                && exists(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)/comments/$(request.resource.data.sourceId))
                && get(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)/comments/$(request.resource.data.sourceId)).data.userId == request.auth.uid)))
          || (request.resource.data.type == 'connection'
            && request.resource.data.detailId == userId
            && exists(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid)))
          || (request.resource.data.type == 'space_connection'
            && exists(/databases/$(database)/documents/communitySpaces/$(request.resource.data.detailId))
            && get(/databases/$(database)/documents/communitySpaces/$(request.resource.data.detailId)).data.creatorId == userId
            && exists(/databases/$(database)/documents/communitySpaces/$(request.resource.data.detailId)/connections/$(request.auth.uid)))
          || (request.resource.data.type == 'space_request'
            && exists(/databases/$(database)/documents/communitySpaces/$(request.resource.data.detailId))
            && get(/databases/$(database)/documents/communitySpaces/$(request.resource.data.detailId)).data.creatorId == userId
            && exists(/databases/$(database)/documents/communitySpaces/$(request.resource.data.detailId)/connectionRequests/$(request.auth.uid))
            && get(/databases/$(database)/documents/communitySpaces/$(request.resource.data.detailId)/connectionRequests/$(request.auth.uid)).data.status == 'pending')));
      allow update: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow delete: if isAuthenticated()
        && (request.auth.uid == userId || resource.data.actorId == request.auth.uid);
    }

    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, delete: if isAuthenticated() && request.auth.uid == userId;
      allow create, update: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && ((request.resource.data.token is string
            && request.resource.data.token.size() > 0
            && request.resource.data.token.size() <= 4096)
          || (request.resource.data.fid is string
            && request.resource.data.fid.size() > 0
            && request.resource.data.fid.size() <= 256))
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 500;
    }

    match /users/{userId}/connections/{targetUserId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && targetUserId != userId
        && request.resource.data.userId == userId
        && request.resource.data.targetUserId == targetUserId
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(targetUserId));
      allow update: if false;
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId}/followers/{followerId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.auth.uid == followerId
        && followerId != userId
        && request.resource.data.userId == followerId
        && request.resource.data.targetUserId == userId
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAuthenticated() && request.auth.uid == followerId;
    }

    match /users/{userId}/connectedSpaces/{spaceId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    // Public usernames are immutable reservations. The document ID is the
    // lowercase handle, which makes profile routes unique without exposing email.
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated()
        && username.matches('^[a-z0-9_]{3,24}$')
        && request.resource.data.userId == request.auth.uid
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update, delete: if false;
    }

    match /communitySpaces/{spaceId} {
      allow read: if resource.data.get('archived', false) != true || hasPermission('view_community') || hasPermission('manage_community');
      allow create: if false;
      allow update: if spaceId != 'main'
        && spaceId.matches('^[a-z0-9-]{3,32}$')
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 360
        && request.resource.data.symbol is string
        && request.resource.data.symbol.size() > 0
        && request.resource.data.symbol.size() <= 4
        && (!('imageBase64' in request.resource.data) || request.resource.data.imageBase64 == '')
        && (!('bannerBase64' in request.resource.data) || request.resource.data.bannerBase64 == '')
        && (!('imageURL' in request.resource.data) || (request.resource.data.imageURL is string && request.resource.data.imageURL.size() <= 2000))
        && (!('bannerURL' in request.resource.data) || (request.resource.data.bannerURL is string && request.resource.data.bannerURL.size() <= 2000))
        && (isAuthenticated()
          && resource.data.creatorId == request.auth.uid
          && request.resource.data.creatorId == resource.data.creatorId
          && request.resource.data.get('creatorUsername', '') == resource.data.get('creatorUsername', '')
          && request.resource.data.get('archived', false) == resource.data.get('archived', false)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['archiveReason', 'archiveCause', 'archiveCascadeId', 'archivedAt', 'archivedBy', 'moderationStatus', 'moderationReason', 'moderationUpdatedAt', 'moderationUpdatedBy'])
          && (!('isPrivate' in request.resource.data) || request.resource.data.isPrivate is bool)
          && (!('isViewOnly' in request.resource.data) || request.resource.data.isViewOnly is bool)
          && (!('showInMainThread' in request.resource.data) || request.resource.data.showInMainThread is bool)
          && !(request.resource.data.get('isPrivate', false) == true && request.resource.data.get('isViewOnly', false) == true)
          && (!('isPrivate' in request.resource.data) || request.resource.data.isPrivate == false || request.resource.data.showInMainThread == false)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'symbol', 'imageBase64', 'bannerBase64', 'imageURL', 'bannerURL', 'updatedAt']));
      allow delete: if false;
    }

    match /communitySpaces/{spaceId}/connections/{userId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /communitySpaces/{spaceId}/connectionRequests/{userId} {
      allow read: if isAuthenticated()
        && (request.auth.uid == userId
          || isSpaceManager(spaceId));
      allow create, update, delete: if false;
    }

    match /communitySettings/{settingId} {
      allow read: if true;
      allow create, update: if hasPermission('manage_community')
        && request.resource.data.promptPostId is string
        && get(/databases/$(database)/documents/communityPosts/$(request.resource.data.promptPostId)).data.type == 'question';
      allow delete: if hasPermission('manage_community');
    }

    // Community members publish thoughts, open questions, and Behance projects.
    // Projects live in the main thread and may request review after publishing.
    match /communityPosts/{postId} {
      allow get: if canReadLivePost(resource.data)
        || hasPermission('view_community')
        || hasPermission('manage_community')
        || (isAuthenticated()
          && resource.data.userId == request.auth.uid
          && resource.data.archiveCause == 'space_cascade'
          && resource.data.moderationStatus != 'flagged');
      allow list: if canListLivePost(resource.data)
        || hasPermission('view_community') || hasPermission('manage_community');
      // Creation is server-owned so identity, publication state, and media counts cannot be forged.
      allow create: if false;
      allow update: if (isAuthenticated()
        && resource.data.userId == request.auth.uid
        && canReadLivePost(resource.data)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.type == resource.data.type
        && request.resource.data.communitySlug == resource.data.communitySlug
          && request.resource.data.get('archived', false) == resource.data.get('archived', false)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['archiveReason', 'archiveCause', 'archiveCascadeId', 'archivedAt', 'archivedBy', 'moderationStatus', 'moderationReason', 'moderationUpdatedAt', 'moderationUpdatedBy', 'flaggedAt', 'flaggedBy', 'warningReason', 'warnedAt', 'warnedBy', 'repostedPostId', 'repostedAt', 'published', 'visibility', 'imagePaths', 'mediaCount', 'mediaFinalizedAt', 'score', 'upvoteCount', 'downvoteCount', 'commentsCount', 'lastActivityAt'])
        && request.resource.data.get('featured', false) == resource.data.get('featured', false)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['editedAt'])
          || request.resource.data.editedAt == request.time)
        && (request.resource.data.get('featureStatus', 'none') == resource.data.get('featureStatus', 'none')
          || (request.resource.data.type == 'behance'
            && resource.data.get('featureRequest', false) == false
            && request.resource.data.featureRequest == true
            && request.resource.data.featureStatus == 'pending'))
          && (request.resource.data.type == 'behance' || request.resource.data.get('featureRequest', false) == false))
        || (isAuthenticated()
          && resource.data.userId == request.auth.uid
          && resource.data.get('archived', false) == true
          && resource.data.archiveCause == 'space_cascade'
          && resource.data.get('moderationStatus', 'clear') != 'flagged'
          && !('repostedPostId' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['repostedPostId', 'repostedAt'])
          && request.resource.data.repostedPostId is string
          && request.resource.data.repostedAt == request.time
          && validRepostLink(postId));
      // Recursive deletion and Storage cleanup are performed by callable functions.
      allow delete: if false;
    }

    match /communityPosts/{postId}/images/{chunkId} {
      allow read: if canReadLivePost(get(/databases/$(database)/documents/communityPosts/$(postId)).data)
        || hasPermission('view_community') || hasPermission('manage_community')
        || (isAuthenticated()
          && get(/databases/$(database)/documents/communityPosts/$(postId)).data.userId == request.auth.uid
          && get(/databases/$(database)/documents/communityPosts/$(postId)).data.archiveCause == 'space_cascade'
          && get(/databases/$(database)/documents/communityPosts/$(postId)).data.moderationStatus != 'flagged');
      allow create, update, delete: if false;
    }

    match /communityPosts/{postId}/votes/{userId} {
      allow read: if (isAuthenticated() && request.auth.uid == userId && canReadLivePost(get(/databases/$(database)/documents/communityPosts/$(postId)).data))
        || hasPermission('view_community') || hasPermission('manage_community');
      allow create, update, delete: if false;
    }

    match /users/{userId}/blockedSpaces/{spaceId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    match /communityPosts/{postId}/comments/{commentId} {
      allow read: if canReadLivePost(get(/databases/$(database)/documents/communityPosts/$(postId)).data)
        || hasPermission('view_community') || hasPermission('manage_community');
      allow create, update, delete: if false;
    }

    match /communitySpaces/{spaceId}/admins/{userId} {
      allow read: if isAuthenticated();
      // Space administrator appointments are validated by callable backend functions.
      allow create, update, delete: if false;
    }

    match /communitySpaces/{spaceId}/access/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSpaceManager(spaceId));
      // This is the canonical server-owned authorization record used by
      // Firestore and Storage. Clients can never grant, change, or revoke it.
      allow create, update, delete: if false;
    }

    match /communitySpaces/{spaceId}/messages/{messageId} {
      allow read: if isSpaceChatMember(spaceId);
      // Message mutations are validated by callable backend operations.
      allow create, update, delete: if false;
    }

    match /communitySpaces/{spaceId}/messages/{messageId}/applause/{userId} {
      allow read: if isSpaceChatMember(spaceId);
      allow create, update, delete: if false;
    }

    match /communitySpaces/{spaceId}/messages/{messageId}/reactions/{userId} {
      allow read: if isSpaceChatMember(spaceId);
      allow create, update, delete: if false;
    }

    match /communitySpaces/{spaceId}/messageReads/{userId} {
      allow read: if isSpaceChatMember(spaceId);
      // A callable validates membership and the last visible message.
      allow create, update, delete: if false;
    }

    match /communitySpaces/{spaceId}/chatPresence/{userId} {
      allow read: if isSpaceChatMember(spaceId);
      allow create, update: if isSpaceChatMember(spaceId)
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['userId', 'activeAt'])
        && request.resource.data.userId == userId
        && request.resource.data.activeAt == request.time;
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    match /communitySpaces/{spaceId}/chatBans/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSpaceManager(spaceId));
      allow create, update, delete: if false;
    }

    match /communitySpaces/{spaceId}/blocks/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSpaceManager(spaceId));
      allow create, update, delete: if false;
    }

    match /communitySpaces/{spaceId}/chatAccessRequests/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSpaceManager(spaceId));
      // Requests and decisions are validated by callable backend operations.
      allow create, update, delete: if false;
    }

    match /communityModerationAudit/{auditId} {
      allow read: if hasPermission('view_community') || hasPermission('manage_community');
      allow create, update, delete: if false;
    }

    match /communityModerationTombstones/{contentType}/items/{contentId} {
      allow read: if hasPermission('view_community') || hasPermission('manage_community');
      allow create, update, delete: if false;
    }

    // Role definitions and assignments contain account emails and are visible
    // only to signed-in users. Only super admins may change system access.
    match /config/{document} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Content permissions are separated by dashboard area. Education is no
    // longer exposed in the dashboard and remains super-admin-only.
    match /content/events/{document=**} {
      allow read: if true;
      allow write: if hasPermission('manage_events');
    }
    match /content/magazine/{document=**} {
      allow read: if true;
      allow write: if hasPermission('manage_articles');
    }
    match /content/library/{document=**} {
      allow read: if true;
      allow write: if hasPermission('manage_library');
    }
    match /content/models3d/{document=**} {
      allow read: if true;
      allow write: if hasPermission('manage_models3d');
    }
    match /content/fbd/{document=**} {
      allow read: if true;
      allow write: if hasPermission('manage_fbd');
    }
    match /content/education/{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /content/{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /content/magazine/articles/{articleId}/votes/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.value in [-1, 0, 1];
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    match /content/magazine/articles/{articleId}/comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && (request.resource.data.parentId == null || request.resource.data.parentId is string);
      allow delete: if hasPermission('manage_articles') || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }
  }
}
